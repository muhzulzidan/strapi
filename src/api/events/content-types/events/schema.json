{
  "kind": "collectionType",
  "info": {
    "singularName": "events",
    "pluralName": "eventses",
    "displayName": "Events",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::event-category.event-category",
      "required": true
    },
    "date": {
      "type": "datetime",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "description": {
      "type": "blocks"
    },
    "highlights": {
      "type": "json"
    },
    "eventFormat": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::event-format.event-format",
      "required": true
    },
    "locationText": {
      "type": "string"
    },
    "meetingUrl": {
      "type": "string",
      "required": false
    },
    "location": {
      "type": "json",
      "required": true
    },
    "speakers": {
      "type": "json"
    },
    "price": {
      "type": "integer",
      "required": true
    },
    "recordingUrl": {
      "type": "string"
    },
    "registrationMode": {
      "type": "string"
    },
    "registrationConfig": {
      "type": "json"
    },
    "isTest": {
      "type": "boolean",
      "default": false
    },
    "sendToWebhook": {
      "type": "boolean",
      "default": false
    },
    "isCancelled": {
      "type": "boolean",
      "default": false,
      "required": false
    },
    "campaignKey": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::campaign.campaign"
    },
    "aliases": {
      "type": "json"
    }
  },
  "collectionName": "eventses"
}